{
  "name": "tamperbox-mcp",
  "version": "0.3.0",
  "description": "Code-mode MCP server for the Tamperbox API with isolated JavaScript execution",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oceanrescue/tamperbox-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/oceanrescue/tamperbox-mcp/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "tamperbox-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "examples",
    "server.json",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "NOTICE.md"
  ],
  "keywords": [
    "mcp",
    "tamperbox",
    "code-mode",
    "claude",
    "openai"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run format:check && npm run typecheck && npm run test:coverage && npm run test:package",
    "test:package": "node scripts/check-package.mjs",
    "test:live": "node scripts/live-smoke.mjs",
    "test:hosted": "npm run build && node scripts/check-hosted.mjs",
    "start": "node dist/cli.js",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "pretest:coverage": "npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync:openapi": "node scripts/sync-openapi.mjs",
    "test:api-integration": "npm run build && node scripts/check-api-integration.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "quickjs-emscripten": "0.32.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "mcpName": "dev.tamperbox/tamperbox-mcp",
  "homepage": "https://tamperbox.dev"
}
